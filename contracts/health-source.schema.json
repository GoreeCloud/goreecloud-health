{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/health/health-source.v1.json",
  "title": "GoreeCloud Health Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_kind"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_kind": {
      "type": "string",
      "enum": ["device", "application", "manual", "import", "synthetic"]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]{1,256}$"
    },
    "source_display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
