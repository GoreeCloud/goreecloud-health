{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/health/sleep-session.v1.json",
  "title": "GoreeCloud Health Sleep Session v1",
  "allOf": [
    {"$ref": "./health-record-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "sleep.session"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stages": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start_time", "end_time", "stage"],
                "properties": {
                  "start_time": {"type": "string", "format": "date-time"},
                  "end_time": {"type": "string", "format": "date-time"},
                  "stage": {
                    "enum": [
                      "unknown",
                      "awake",
                      "sleeping",
                      "out-of-bed",
                      "awake-in-bed",
                      "light",
                      "deep",
                      "rem"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
