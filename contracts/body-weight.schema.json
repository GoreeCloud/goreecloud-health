{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/health/body-weight.v1.json",
  "title": "GoreeCloud Health Body Weight v1",
  "allOf": [
    {"$ref": "./health-record-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "body.weight"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
            "unit": {"const": "kg"}
          }
        }
      }
    }
  ]
}
