{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/health/exercise-session.v1.json",
  "title": "GoreeCloud Health Exercise Session v1",
  "allOf": [
    {"$ref": "./health-record-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "exercise.session"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_classification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["system", "code"],
              "properties": {
                "system": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 96,
                  "pattern": "^[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$"
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        }
      }
    }
  ]
}
